<Window x:Class="FlappyB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlappyB"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="Gray">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Canvas x:Name="palya" Background="ForestGreen" Grid.Row="1">
            <Button x:Name="bt" Content="🐼" Canvas.Left="65" Canvas.Top="143" Height="34" Width="37" Click="bt_Click" FontSize="22" HorizontalAlignment="Left" VerticalAlignment="Center" Focusable="False"/>


        </Canvas>
        <Button Content="Alap" HorizontalAlignment="Left" Margin="27,14,0,0" VerticalAlignment="Top" Click="Button_Click" Height="46" Width="123" Background="LightGreen"/>
        <Button Content="Eső" HorizontalAlignment="Left" Margin="172,14,0,0" VerticalAlignment="Top" Height="46" Width="136" Background="Gold" Click="Button_Click_1"/>
        <Button Content="Köd" HorizontalAlignment="Left" Margin="323,14,0,0" VerticalAlignment="Top" Height="46" Width="125" Background="Red" Click="Button_Click_2"/>
        <Button Content="Eső+Köd" HorizontalAlignment="Left" Margin="464,14,0,0" VerticalAlignment="Top" Height="46" Width="125" Background="Red" Click="Button_Click_3"/>
        <TextBlock x:Name="point" HorizontalAlignment="Left" Margin="694,40,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="26" Width="96"><Run Language="hu-hu" Text="Pontszám:"/></TextBlock>
    </Grid>
</Window>
